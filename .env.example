# Copy this file to ".env" and fill in your own values.

# Where MySQL runs
DB_HOST=localhost
DB_PORT=3306

# Main database and the limited user the web app logs in with
# (setup_db.py creates this user for you)
DB_NAME=stockflow
DB_USER=stockflow_app
DB_PASSWORD=change_me_app_password

# Your MySQL admin login (used only by the setup, demo, backup scripts)
ROOT_USER=root
ROOT_PASSWORD=your_mysql_root_password

# Any long random text. Flask uses it to protect the login cookie.
SECRET_KEY=change_me_to_any_long_random_text

# Folder that has mysqldump and mysql (only needed for backup/restore
# if they are not already on your PATH). Windows example:
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin
MYSQL_BIN=
